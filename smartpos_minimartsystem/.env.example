SECRET_KEY=change-me-to-a-long-random-string

# MySQL (XAMPP defaults: host 127.0.0.1, user root, empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartpos_minimart

STORE_NAME=Mini Mart
DEFAULT_TAX_PERCENT=0
# Starting USD -> KHR rate; admins can change it live from POS Checkout.
# Once changed there it is stored in the `settings` table and overrides this.
KHR_EXCHANGE_RATE=4100

# Optional — Telegram store-activity alerts (new products, restocks, low
# stock, purchase orders, sales, refunds, new staff/roles, password resets).
# Leave both blank to disable; every alert silently no-ops until both are set.
# Create a bot with @BotFather on Telegram to get a token, add the bot to
# your group/channel, then get that chat's ID (e.g. via @userinfobot) —
# group/channel IDs are usually a negative number like -1001234567890.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
